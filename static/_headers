/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' CDN_SCRIPTS https://www.googletagmanager.com/gtag/js blob:; worker-src 'self' blob:; connect-src 'self' CDN_SCRIPTS CDN_DATA https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com blob: data:; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=2592000

# workers.dev copies (production and preview versions) stay out of search; canonicals point at anyredact.app.
https://:host.slop-9bb.workers.dev/*
  X-Robots-Tag: noindex
